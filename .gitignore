# Secrets & Environment variables
.env
.env.*
!.env.example

# Python caches, virtual environments & linters
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
ENV/

# Build & platform run artifacts
dist/
build/
*.egg-info/
submission.csv
*.tmp
pytest.cmd
*.log

# Auto-generated knowledge base artifacts (role R)
docs.json
chunks.jsonl
emb.npy
emb_meta.json
*.bm25

# Local test data & platform sandbox
data/questions.csv
data/knowledge-base.zip
data/*.csv
data/*.zip
sandbox/
psb_sandbox_*/

# Evaluation logs & cache (role B)
eval/runs/
eval/.judge_cache.json

# Go binaries & build cache
backend-go/*.exe
backend-go/server
backend-go/api
bin/
*.exe

# OS & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
