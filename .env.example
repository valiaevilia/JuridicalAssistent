# ==============================================================================
# ПСБ «Юридический ассистент» — Пример конфигурации окружения (.env.example)
# Скопируйте данный файл в .env и укажите ваши параметры подключения к моделям.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Сетевой прокси и авторизация
# ------------------------------------------------------------------------------
# Базовый URL локального или внешнего OpenAI-совместимого прокси
# На платформе проверки ПСБ подставляется автоматически через LLM_BASE_URL
LLM_BASE_URL=http://localhost:8001/v1

# Служебный API-ключ для доступа к прокси (на платформе подставляется автоматически)
LLM_API_KEY=dummy-key

# Опциональные раздельные ключи (если не заданы, используется LLM_API_KEY)
EMBEDDER_API_KEY=
RERANKER_API_KEY=

# ------------------------------------------------------------------------------
# 2. Идентификаторы моделей (по регламенту ПСБ)
# ------------------------------------------------------------------------------
# Генеративная модель для ответов и классификации
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Модель векторных эмбеддингов для гибридного поиска
EMB_MODEL=baai/bge-m3

# Модель кросс-энкодер реранкинга (с fallback на Qwen/Qwen3-Reranker-8B)
RERANKER_MODEL=cohere/rerank-5-fast

# ------------------------------------------------------------------------------
# 3. Параметры инференса и платформенного раннера
# ------------------------------------------------------------------------------
# Количество параллельных потоков обработки вопросов (регламент: до 8 CPU)
MAX_WORKERS=5

# Температура генерации (0.0 для детерминированных юридических ответов)
TEMPERATURE=0.0

# Максимальное количество токенов в ответе модели
MAX_TOKENS=2048

# Путь к входным данным платформы
# В Docker Compose это путь к папке на хосте: она монтируется в /app/data только для чтения.
DATA_DIR=data

# Только предзаданные демонстрационные ответы; при false используется R -> L -> клиент B.
DEMO_MODE=false

# ------------------------------------------------------------------------------
# 4. Внутренний мост Go Gateway <-> Python Worker
# ------------------------------------------------------------------------------
# Адрес внутреннего легковесного Python-воркера для обработки чата из Go-бэкенда
PY_WORKER_URL=http://127.0.0.1:8001

# Порт HTTP-сервера Go Gateway (по умолчанию 8000)
PORT=8000
